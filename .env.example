# Postgres connection string (Neon/Supabase pooled connection recommended)
DATABASE_URL="postgresql://user:password@host:5432/shopify_bi?schema=public"

# 32-byte key, base64-encoded, used for AES-256-GCM encryption of Shopify credentials at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# Single admin login for Phase 1 (no self-serve signup).
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""

# Anthropic API key for AI reports + chat.
ANTHROPIC_API_KEY=""

# Public base URL of the deployed web app, used to register Shopify webhook endpoints.
APP_BASE_URL="https://your-app.vercel.app"
